{
  "version": 3,
  "routes": [
    {
      "src": "/_app/immutable/.+",
      "headers": {
        "cache-control": "public, immutable, max-age=31536000"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(__data.json)?"
    },
    {
      "src": "^/api/leaderboard(/__data.json)?"
    },
    {
      "src": "^/api/puzzle(/__data.json)?"
    },
    {
      "src": "^/api/puzzle/verify(/__data.json)?"
    },
    {
      "src": "^/play/([^/]+?)(/__data.json)?"
    },
    {
      "src": "/.*"
    }
  ]
}